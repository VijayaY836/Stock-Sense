# --- Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Database (local PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stocksense
# Separate DB used only by `npm test` (it gets wiped on every run)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/stocksense_test

# --- Auth (change this! use a long random string)
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# --- Email for OTP (optional). If SMTP_HOST is empty, the OTP is printed in this terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StockSense <no-reply@stocksense.local>"
